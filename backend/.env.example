# Copy to .env and fill in. NEVER share this file.
ADMIN_API_KEY=choose-a-long-random-password
TOKEN_SECRET=choose-another-long-random-string
USER_AGENT=GovJobsTracker/1.0 (contact: your-email@example.com)
# Path INSIDE the container. Put your Firebase key at secrets/firebase.json (see README).
FIREBASE_CREDENTIALS=/secrets/firebase.json
